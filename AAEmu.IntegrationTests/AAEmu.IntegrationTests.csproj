                      LogicalName="AAEmu.IntegrationTests.Migrations.2026-09-13_aaemu_game_expedition_instance_histories.sql" />
    <EmbeddedResource Include="..\SQL\updates\2026-09-13_aaemu_game_expedition_instance_history_type.sql"
                      LogicalName="AAEmu.IntegrationTests.Migrations.2026-09-13_aaemu_game_expedition_instance_history_type.sql" />
    <EmbeddedResource Include="..\SQL\updates\2026-09-13_aaemu_game_expedition_daily_exp.sql"
                      LogicalName="AAEmu.IntegrationTests.Migrations.2026-09-13_aaemu_game_expedition_daily_exp.sql" />
