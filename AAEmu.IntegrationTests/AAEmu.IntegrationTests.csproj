<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <NoWarn>CA1859</NoWarn>
    <!-- Enable Testing Platform support for xunit -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\AAEmu.Commons\AAEmu.Commons.csproj" />
    <ProjectReference Include="..\AAEmu.Game\AAEmu.Game.csproj" />
    <!-- Level-pack placement tests read the real doodad.g cells through the production catalog. -->
    <ProjectReference Include="..\AAEmu.WorldServer\AAEmu.World\AAEmu.World.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.Telemetry" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport.Abstractions" />
    <PackageReference Include="Microsoft.Testing.Platform.MSBuild" />
    <PackageReference Include="Moq" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
    <EmbeddedResource Include="..\SQL\updates\2026-09-13_aaemu_game_families.sql"
                      LogicalName="AAEmu.IntegrationTests.Migrations.2026-09-13_aaemu_game_families.sql" />
