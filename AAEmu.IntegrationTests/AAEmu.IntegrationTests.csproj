    <EmbeddedResource Include="..\SQL\updates\2026-09-13_aaemu_game_expedition_descriptor_state.sql"
                      LogicalName="AAEmu.IntegrationTests.Migrations.2026-09-13_aaemu_game_expedition_descriptor_state.sql" />
    <EmbeddedResource Include="..\SQL\updates\2026-09-13_aaemu_game_expedition_public_assignments.sql"
                      LogicalName="AAEmu.IntegrationTests.Migrations.2026-09-13_aaemu_game_expedition_public_assignments.sql" />
