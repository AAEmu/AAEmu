{
    // Schedule-driven dynamic weather. Each phase binds one game_schedules row: the content row
    // owns the window (daily time, weekday, calendar bounds); this file only says which weather
    // that window produces. An empty list keeps dynamic weather off and says so at boot.
    //
    //   "Phases": [
    //     { "ScheduleId": <game_schedules id>, "State": "Rain" },
    //     { "ScheduleId": <game_schedules id>, "State": "Wind" },
    //     { "ScheduleId": <game_schedules id>, "State": "Snow" }
    //   ]
    //
    // Exactly one phase may be open at a time; an overlap is reported and keeps the previous
    // state. State names are WeatherState values (Clear/Rain/Wind/Snow); an unknown name or a
    // schedule id with no row is reported loudly and the phase is skipped.
    "Weather": {
        "Phases": []
    }
}
