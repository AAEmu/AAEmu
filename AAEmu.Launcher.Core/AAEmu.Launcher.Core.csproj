    <Description>Core library for launching the ArcheAge game client. Handles ticket building, RC4 encryption, and shared-memory IPC for the Trion authentication protocol.</Description>
    <Authors>AAEmu contributors</Authors>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aaemu/AAEmu</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aaemu/AAEmu</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>aaemu;archeage</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>