@page
@model AAEmu.Web.Pages.Characters.IndexModel
@{
    ViewData["Title"] = "Characters";
}

<div class="page-head">
    <h1>Characters</h1>
    <p>Every character in the game database.</p>
</div>

@if (Model.DatabaseUnavailable)
{
    <div class="alert alert-error">
        The game database is not reachable. Check <code>Connections:GameMySQLProvider</code> in
        <code>Config.Local.json</code>.
    </div>
}
else
{
    <form class="toolbar" method="get">
        <input type="search" name="search" value="@Model.Search" placeholder="Search by character name&hellip;" aria-label="Search by character name" />
        <label class="checkbox">
            <input type="checkbox" name="deleted" value="true" checked="@Model.IncludeDeleted" />
            Include deleted
        </label>
        <button class="btn btn-secondary" type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.IncludeDeleted)
        {
            <a class="btn btn-secondary" asp-page="/Characters/Index">Clear</a>
        }
    </form>

    <div class="table-wrap">
        @if (Model.Characters.Count == 0)
        {
            <div class="empty-state">
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <text>No characters match &ldquo;@Model.Search&rdquo;.</text>
                }
                else
                {
                    <text>No characters yet.</text>
                }
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Lvl</th>
                        <th>Race</th>
                        <th>Faction</th>
                        <th>Money</th>
                        <th>Played</th>
                        <th>Account</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var character in Model.Characters)
                {
                    <tr class="@(character.Deleted ? "row-deleted" : "")">
                        <td class="username">
                            @character.Name
                            @if (character.Deleted)
                            {
                                <span class="badge badge-banned">Deleted</span>
                            }
                            @if (character.AccessLevel > 0)
                            {
                                <span class="badge badge-gm">GM @character.AccessLevel</span>
                            }
                        </td>
                        <td class="numeric">@character.Level</td>
                        <td class="muted">@character.Race / @character.Gender</td>
                        <td class="muted">@(string.IsNullOrWhiteSpace(character.FactionName) ? $"#{character.FactionId}" : character.FactionName)</td>
                        <td class="numeric">@character.FormattedMoney</td>
                        <td class="numeric">@character.FormattedPlayTime</td>
                        <td>
                            <a asp-page="/Accounts/Details" asp-route-id="@character.AccountId">
                                @(character.Username ?? $"#{character.AccountId}")
                            </a>
                        </td>
                        <td class="muted">@character.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>

    @if (Model.TotalCount > 0)
    {
        <div class="pagination">
            <span class="page-info">
                Showing @Model.FirstRowOnPage&ndash;@Model.LastRowOnPage of @Model.TotalCount.ToString("N0")
            </span>
            <span class="page-links">
                <a class="btn btn-secondary @(Model.HasPreviousPage ? "" : "disabled")"
                   asp-page="/Characters/Index"
                   asp-route-search="@Model.Search"
                   asp-route-deleted="@(Model.IncludeDeleted ? "true" : null)"
                   asp-route-p="@(Model.PageNumber - 1)">Previous</a>
                <a class="btn btn-secondary @(Model.HasNextPage ? "" : "disabled")"
                   asp-page="/Characters/Index"
                   asp-route-search="@Model.Search"
                   asp-route-deleted="@(Model.IncludeDeleted ? "true" : null)"
                   asp-route-p="@(Model.PageNumber + 1)">Next</a>
            </span>
        </div>
    }
}
