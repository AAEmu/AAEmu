# EditorConfig is awesome: http://EditorConfig.org

# top-most EditorConfig file
root = true

# Don't use tabs for indentation.
[*]
indent_style = space
# (Please don't specify an indent_size here; that has too many unintended consequences.)

# Rust sources (formatting itself is enforced by rustfmt / `cargo fmt --check` in CI)
[*.rs]
indent_size = 4
insert_final_newline = true
charset = utf-8

# Cargo manifests, CI workflows, compose files
[*.{toml,yml,yaml}]
indent_size = 2

# JSON files (server configs and data)
[*.json]
indent_size = 4

[*.{sh}]
end_of_line = lf
indent_size = 2

[*.{ps1,bat}]
indent_size = 4
