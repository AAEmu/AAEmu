<Application x:Class="AAEmu.BillManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="GridBg" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="GridRowAlt" Color="#333333"/>
    <SolidColorBrush x:Key="GridHeaderBg" Color="#111111"/>
    <SolidColorBrush x:Key="GridHeaderFg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GridCellFg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="GridLine" Color="#444444"/>
    <SolidColorBrush x:Key="InputBg" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="InputFg" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#555555"/>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource InputFg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource InputFg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
      <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="Foreground" Value="{StaticResource InputFg}"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource GridBg}"/>
      <Setter Property="Foreground" Value="{StaticResource GridCellFg}"/>
      <Setter Property="RowBackground" Value="{StaticResource GridBg}"/>
      <Setter Property="AlternatingRowBackground" Value="{StaticResource GridRowAlt}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource GridLine}"/>
      <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource GridHeaderBg}"/>
      <Setter Property="Foreground" Value="{StaticResource GridHeaderFg}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="{StaticResource GridLine}"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Foreground" Value="{StaticResource GridCellFg}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Foreground" Value="{StaticResource GridCellFg}"/>
    </Style>
  </Application.Resources>
</Application>
