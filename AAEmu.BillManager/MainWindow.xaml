<Window x:Class="AAEmu.BillManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AAEmu Bill Manager" Height="700" Width="1200"
        Background="#1e1e1e" Foreground="#eee"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="Bill Server control + cash-shop catalog" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBlock x:Name="ServerStateText" Text="Bill Server: checking..." FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="BillServer.exe path" Opacity="0.85"/>
          <Grid Margin="0,2,8,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExePathBox" Grid.Column="0" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Browse…" Click="OnBrowseExe" Padding="8,4"/>
          </Grid>
          <TextBlock Text="Admin URL" Opacity="0.85"/>
          <TextBox x:Name="AdminUrlBox" Margin="0,2,8,6" Text="http://127.0.0.1:18080"/>
          <TextBlock Text="Client compact.sqlite3 (item names)" Opacity="0.85"/>
          <Grid Margin="0,2,8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CompactPathBox" Grid.Column="0" Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Browse…" Click="OnBrowseCompact" Padding="8,4"/>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button x:Name="StartBillButton" Content="Start" Width="80" Margin="4" Click="OnStartBill" Padding="8,4"/>
          <Button x:Name="StopBillButton" Content="Stop" Width="80" Margin="4" Click="OnStopBill" Padding="8,4"/>
          <Button x:Name="RestartBillButton" Content="Restart" Width="80" Margin="4" Click="OnRestartBill" Padding="8,4"/>
          <Button Content="Refresh" Width="90" Margin="4" Click="OnRefresh" Padding="8,4"/>
          <Button x:Name="SaveAllButton" Content="Save all" Width="90" Margin="4" Click="OnSaveAll" Padding="8,4"/>
          <Button Content="Save row" Width="90" Margin="4" Click="OnSaveSelected" Padding="8,4"/>
          <Button Content="Fill names" Width="90" Margin="4" Click="OnFillNames" Padding="8,4"/>
          <Button Content="Publish→ICS" Width="110" Margin="4" Click="OnPublish" Padding="8,4"/>
        </StackPanel>
      </Grid>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBlock Text="Grant cash account" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="AccountBox" Width="100" Text="1" Margin="0,0,8,0"/>
        <TextBlock Text="amount" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox x:Name="AmountBox" Width="80" Text="5000" Margin="0,0,8,0"/>
        <Button Content="Add cash" Click="OnAddCash" Padding="8,4"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
        <TextBlock Text="Main tab" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.85"/>
        <ComboBox x:Name="FilterMainTab" Width="140" Margin="0,0,12,0"
                  SelectionChanged="OnFilterTabChanged" DisplayMemberPath="Name"/>
        <TextBlock Text="Sub tab" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.85"/>
        <ComboBox x:Name="FilterSubTab" Width="140" Margin="0,0,12,0"
                  SelectionChanged="OnFilterTabChanged" DisplayMemberPath="Name"/>
        <Button Content="All tabs" Click="OnClearFilter" Padding="8,4" Margin="0,0,8,0"/>
        <TextBlock x:Name="FilterSummary" VerticalAlignment="Center" Opacity="0.75"/>
      </StackPanel>
      <TextBlock x:Name="StatusLine" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.85"/>
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Opacity="0.65" Margin="0,8,0,0" TextWrapping="Wrap"
               Text="Workflow: edit rows → Save all → Publish→ICS → in-game /ics off → /ics reload → /ics on. Stop uses graceful shutdown when possible."/>

    <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False"
              HeadersVisibility="Column" AlternationCount="2"
              SelectionMode="Single" IsReadOnly="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Shop ID" Binding="{Binding ShopId}" IsReadOnly="True" Width="80"/>
        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="On shop" Binding="{Binding Available}" Width="70"/>
        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="70"/>
        <DataGridTextColumn Header="Discount" Binding="{Binding DiscountPrice}" Width="80"/>
        <DataGridTextColumn Header="Buy limit" Binding="{Binding BuyLimit}" Width="80"/>
        <DataGridTextColumn Header="Limit type" Binding="{Binding LimitType}" Width="80"/>
        <DataGridTextColumn Header="Item ID" Binding="{Binding ItemId}" Width="80"/>
        <DataGridTextColumn Header="In-game tab" Binding="{Binding TabPath}" IsReadOnly="True" Width="180"/>
        <DataGridComboBoxColumn Header="Main tab" Width="130"
                                SelectedValueBinding="{Binding MainTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Id" DisplayMemberPath="Name"/>
        <DataGridTemplateColumn Header="Sub tab" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding SubTabName}" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate>
              <ComboBox x:Name="SubTabEditor"
                        SelectedValue="{Binding SubTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Id" DisplayMemberPath="Name"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Pos" Binding="{Binding TabPos}" Width="50"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
