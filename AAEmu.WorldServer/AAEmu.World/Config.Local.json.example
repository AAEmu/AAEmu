{
  "GameContentRoot": "/path/to/AAEmu.Game/bin/Debug/net10.0",
  "ZoneGameDataRoot": "/path/to/zone/game/data",
  "ZoneHost": {
    "Enabled": true,
    "Executable": "/path/to/Bin64/AAEmu.ZoneHost.exe",
    "WorkingDirectory": "/path/to/Bin64",
