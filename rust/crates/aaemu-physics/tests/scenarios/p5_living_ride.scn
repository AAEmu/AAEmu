# P5: a living entity standing on a rigid raft that is set moving and turning (moving-ground
# following, ground velocity, proxy-body contacts), then walking off it.
grid axisz=2 org=-128,-128,-100 n=64,64 step=4,4
geom name=ground type=box size=30,30,1
geom name=plat type=box size=2,2,0.2
entity name=floor type=static pos=0,0,-1
part ent=floor geom=ground
entity name=raft type=rigid pos=0,0,0.2
part ent=raft geom=plat mass=300
params target=raft type=10 i4=U f8=U f12=U f16=U v20=U f32=U f36=U f40=U f44=U f48=U f52=U f56=U i60=U i64=U f68=U f72=U f76=U f80=0
entity name=p type=living pos=0.3,0.2,0.4
trace ents=p,raft
step n=30
action target=raft type=10 i4=U i8=U v12=1.5,0,0 v24=0,0,0.4 i36=0
step n=15
action target=raft type=10 i4=U i8=U v12=1.5,0.3,0 v24=0,0,0.4 i36=0
step n=15
status target=p type=2 dump=4,27
action target=p type=1 v4=0,2.5,0 i16=0 f20=0
step n=60
status target=p type=2 dump=4,27
