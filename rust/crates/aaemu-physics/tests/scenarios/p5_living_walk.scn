# P5: a living entity falls onto a static box floor, walks, turns, stops.
grid axisz=2 org=-128,-128,-100 n=64,64 step=4,4
geom name=ground type=box size=20,20,1
entity name=floor type=static pos=0,0,-1
part ent=floor geom=ground
entity name=p type=living pos=1,2,0.7
getparams target=p type=1 dump=4,15
getparams target=p type=4 dump=4,24
trace ents=p
step n=25
status target=p type=2 dump=4,37
action target=p type=1 v4=3,0,0 i16=0 f20=0
step n=20
action target=p type=1 v4=1,2.5,0 i16=0 f20=0
step n=20
status target=p type=2 dump=4,37
status target=p type=8 dump=12,30
action target=p type=1 v4=0,0,0 i16=0 f20=0
step n=25
params target=p type=4 f4=2 f8=U f12=U f16=U f20=U f28=U f32=U i36=U f40=U i44=U f48=U f52=U f56=U f60=U f64=U f68=U i72=U p80=unused i92=U
action target=p type=1 v4=-2,0,0 i16=0 f20=0
step n=30
status target=p type=2 dump=4,37
