# P5: jumping (action_move iJump 1 / 2), air control, a fall from a 40 m tower (>= 20 m/s at
# impact), impulses, set_velocity and reset.
grid axisz=2 org=-128,-128,-100 n=64,64 step=4,4
geom name=ground type=box size=30,30,1
geom name=towerg type=box size=2,2,20
entity name=floor type=static pos=0,0,-1
part ent=floor geom=ground
entity name=tower type=static pos=10,10,20
part ent=tower geom=towerg
entity name=a type=living pos=0,0,0.1
entity name=b type=living pos=10,10,40.5
trace ents=a,b
step n=15
params target=a type=4 f4=U f8=U f12=0.5 f16=0.1 f20=U f28=U f32=U i36=U f40=U i44=U f48=U f52=U f56=U f60=U f64=U f68=U i72=U p80=unused i92=U
action target=a type=1 v4=0,0,6 i16=1 f20=0
step n=5
action target=a type=1 v4=2,1,0 i16=0 f20=0
step n=40
status target=a type=2 dump=4,37
action target=a type=1 v4=0,0,4 i16=2 f20=0
step n=3
action target=b type=1 v4=1.6,0,0 i16=0 f20=0
step n=50
action target=b type=1 v4=0,0,0 i16=0 f20=0
step n=90 every=3
status target=b type=2 dump=4,37
status target=b type=8 dump=12,30
action target=a type=2 v4=200,0,150 f16=U f28=U f40=U f52=U i64=U i68=U i72=0 i76=0
step n=20
action target=a type=10 i4=U i8=U v12=0,3,0 f24=U f28=U f32=U i36=0
step n=10
action target=a type=4 i4=0
step n=10
status target=a type=2 dump=4,37
