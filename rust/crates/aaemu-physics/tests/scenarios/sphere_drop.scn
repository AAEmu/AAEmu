# 0.5 m radius sphere (20 kg) dropped from z=4 onto the box ground, with a small sideways velocity.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=ground type=box size=50,50,0.5
entity name=ground type=static pos=32,32,-0.5
part ent=ground geom=ground mass=0
geom name=ball type=sphere r=0.5
entity name=ball type=rigid pos=32,32,4
part ent=ball geom=ball mass=20
action target=ball type=10 v12=1,0,0
trace ents=ball
print
step n=120
