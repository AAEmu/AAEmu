# P1c mesh-mesh: two rigid trimesh bodies colliding. A mesh box thrown at a resting mesh box,
# two icospheres meeting head-on in the air, a spinning mesh box hitting a mesh cylinder; all
# over a static trimesh floor.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=floor type=mesh gen=grid nx=8 ny=8 step=4
entity name=floor type=static pos=64,64,0
part ent=floor geom=floor mass=0
geom name=mbox type=mesh gen=box size=0.5,0.5,0.5
geom name=mico type=mesh gen=icosphere r=0.5 sub=2
geom name=mcyl type=mesh gen=cylinder r=0.4 hh=0.6 seg=16
geom name=mobb type=mesh gen=box size=0.6,0.4,0.3 flags=0x20
entity name=rest type=rigid pos=58,58,0.5
part ent=rest geom=mbox mass=10
entity name=thrown type=rigid pos=54,58.2,0.8 q=0.0000000,0.0000000,0.0871557,0.9961947
part ent=thrown geom=mbox mass=10
action target=thrown type=10 v12=6,0,0
entity name=icoA type=rigid pos=60,68,3
part ent=icoA geom=mico density=1000
action target=icoA type=10 v12=3,0,1
entity name=icoB type=rigid pos=66,68.3,3
part ent=icoB geom=mico density=1000
action target=icoB type=10 v12=-3,0,1
entity name=spinner type=rigid pos=70,60,1.5 q=0.2588190,0.0000000,0.0000000,0.9659258
part ent=spinner geom=mbox mass=10
action target=spinner type=10 v12=0,4,0 v24=0,0,6
entity name=target type=rigid pos=70,64,0.6
part ent=target geom=mcyl mass=20
trace ents=rest,thrown,icoA,icoB,spinner,target
print
step n=90
step n=210 every=5
