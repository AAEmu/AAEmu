# P5: a living entity runs over bumpy heightfield terrain and jumps on it.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=hf type=heightfield n=128,128 step=1,1 hscale=1 fn=bumps h0=0 amp=0.12 worldhf=1
entity name=a type=living pos=20,20,2
trace ents=a
step n=30
action target=a type=1 v4=3,1,0 i16=0 f20=0
step n=60
action target=a type=1 v4=0,0,5 i16=1 f20=0
step n=40
action target=a type=1 v4=0,0,0 i16=0 f20=0
step n=30
status target=a type=2 dump=4,27
