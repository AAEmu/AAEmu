# P5: living entities on heightfield terrain: a slope (h = 1 + 0.15 ix + 0.05 iy) walked up, down
# and across, and bumpy terrain.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=hf type=heightfield n=128,128 step=1,1 hscale=1 fn=slope h0=1 kx=0.15 ky=0.05 worldhf=1
entity name=a type=living pos=40,40,10
entity name=b type=living pos=60,50,13
trace ents=a,b
step n=30
action target=a type=1 v4=2,0,0 i16=0 f20=0
action target=b type=1 v4=-2,1,0 i16=0 f20=0
step n=60
status target=a type=2 dump=4,27
status target=b type=2 dump=4,27
action target=a type=1 v4=-1,3,0 i16=0 f20=0
action target=b type=1 v4=0,0,0 i16=0 f20=0
step n=60 every=2
status target=a type=2 dump=4,27
