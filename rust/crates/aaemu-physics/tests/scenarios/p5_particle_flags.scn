params target=c type=3 i4=U f8=U f12=U f16=U f20=U f32=U f36=U f40=U f44=U f48=U i52=U f56=U f68=U f80=U f92=U f104=U f128=U f132=U f136=U p144=unused i152=U i156=U i160=U i4=0x10 f8=0.5 f12=0.2 v20=0.8,0.6,0 f32=2 v56=2,2,0 i52=1
params target=d type=3 i4=U f8=U f12=U f16=U f20=U f32=U f36=U f40=U f44=U f48=U i52=U f56=U f68=U f80=U f92=U f104=U f128=U f132=U f136=U p144=unused i152=U i156=U i160=U i4=1 f8=0.5 f12=0.2 v20=0.6,0.8,0 f32=4 v56=0,0,3 i52=1
