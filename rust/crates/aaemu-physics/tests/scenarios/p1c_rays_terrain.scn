# P1c rays: RayWorldIntersection against heightfield terrain (bumps h = 0.3*((7ix + 13iy) mod 5),
# 128x128 cells of 1 m): vertical grids at cell corners/edges/centres, slanted, grazing (nearly
# horizontal), upward from below the surface, terrain-only / no-terrain masks.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=hf type=heightfield n=128,128 step=1,1 hscale=1 fn=bumps h0=0 amp=0.3 worldhf=1
