part ent=car geom=wheel mass=20 pos=-1.1,-1.4,-0.45 i0=1 i112=0 i116=1 i120=1 i124=0 v128=-1.1,-1.4,-0.2 f140=0.4 f144=0.25 f148=0.25 f152=0 f156=-0.5 f160=U f164=U f168=U f172=U f176=U f180=U
trace ents=car
step n=40 every=10
params target=car type=2 f8=150000 f20=4000 f64=2500 f68=1200 f72=800 f60=300 f80=2 i84=6 p88=buf:400 f400=-3 f404=0 f408=3.5 f412=2.4 f416=1.6 f420=1.1 i96=5 i100=1
