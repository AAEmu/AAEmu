# P1c mesh-mesh: rigid trimesh bodies onto static trimesh objects standing on a primitive box
# ground: a box onto a mesh slab, an icosphere onto a big static icosphere (off centre, rolls
# off), a box onto a lying mesh cylinder, a cylinder onto a mesh box corner.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=ground type=box size=40,40,0.5
entity name=ground type=static pos=64,64,-0.5
part ent=ground geom=ground mass=0
geom name=mbox type=mesh gen=box size=0.5,0.5,0.5
geom name=mico type=mesh gen=icosphere r=0.5 sub=2
geom name=mcyl type=mesh gen=cylinder r=0.4 hh=0.6 seg=16
geom name=mobb type=mesh gen=box size=0.6,0.4,0.3 flags=0x20
geom name=slab type=mesh gen=box size=2,2,0.25
geom name=bigico type=mesh gen=icosphere r=1.5 sub=2
geom name=log type=mesh gen=cylinder r=0.6 hh=2 seg=24
geom name=block type=mesh gen=box size=1,1,1 flags=0x20
entity name=slab type=static pos=56,64,0.25
part ent=slab geom=slab mass=0
entity name=bigico type=static pos=62,64,1.5
part ent=bigico geom=bigico mass=0
entity name=log type=static pos=68,64,0.6 q=0.7071068,0.0000000,0.0000000,0.7071068
part ent=log geom=log mass=0
entity name=block type=static pos=74,64,1 q=0.0000000,0.0000000,0.2588190,0.9659258
part ent=block geom=block mass=0
entity name=onslab type=rigid pos=56.3,64.2,3 q=0.1002558,0.1002558,0.1002558,0.9848078
part ent=onslab geom=mbox mass=10
entity name=onico type=rigid pos=62.4,64.3,5
part ent=onico geom=mico density=1000
entity name=onlog type=rigid pos=68,64.5,3.5 q=0.0000000,0.0000000,0.3826834,0.9238795
part ent=onlog geom=mbox mass=10
entity name=onblock type=rigid pos=74.5,64.5,4.5 q=0.5000000,0.0000000,0.0000000,0.8660254
part ent=onblock geom=mcyl mass=20
trace ents=onslab,onico,onlog,onblock
print
step n=90
step n=210 every=5
