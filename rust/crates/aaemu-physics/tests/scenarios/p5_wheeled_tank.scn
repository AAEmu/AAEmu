part ent=car geom=wheel mass=20 pos=-1.1,-1.4,-0.45 i0=1 i112=1 i116=1 i120=1 i124=0 v128=-1.1,-1.4,-0.2 f140=0.4 f144=0.25 f148=0.25 f152=0 f156=-0.5 f160=U f164=U f168=U f172=U f176=U f180=U
