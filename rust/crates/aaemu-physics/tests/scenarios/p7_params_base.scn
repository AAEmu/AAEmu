# P7 entity interface, CPhysicalEntity (static): SetParams / GetParams / GetStatus / Action ids
# replayed by tests/p7_params.rs (no TimeStep: entities stay in the creation queue).
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=cube type=box size=0.5,0.5,0.5
geom name=ball type=sphere r=0.3
entity name=st type=static pos=10,12,1 q=0,0,0.38268343,0.92387953
part ent=st geom=cube mass=0
part ent=st geom=ball mass=0 pos=1,0,0.5 id=7
echo status_pos
status target=st type=1 i4=-1 i8=-1 dump=4,20
status target=st type=1 i4=-1 i8=1 dump=4,20
status target=st type=1 i4=7 i8=-1 dump=4,20
