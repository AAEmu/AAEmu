# P5: a living entity lands on a rigid platform sliding over the floor, then walks into a light
# rigid box and pushes it.
grid axisz=2 org=-128,-128,-100 n=64,64 step=4,4
geom name=ground type=box size=30,30,1
geom name=plat type=box size=1.5,1.5,0.25
geom name=crate type=box size=0.4,0.4,0.9
entity name=floor type=static pos=0,0,-1
part ent=floor geom=ground
entity name=platform type=rigid pos=0,0,0.25
part ent=platform geom=plat mass=400
entity name=box type=rigid pos=4,0,0.9
part ent=box geom=crate mass=10
entity name=p type=living pos=0.2,0,2
trace ents=p,platform,box
step n=10
action target=platform type=10 i4=U i8=U v12=2,0,0 f24=U f28=U f32=U i36=0
step n=60
status target=p type=2 dump=4,27
action target=p type=1 v4=2,0,0 i16=0 f20=0
step n=120
status target=p type=2 dump=4,27
