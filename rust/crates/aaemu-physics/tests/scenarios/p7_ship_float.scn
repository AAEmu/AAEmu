# P7 stress: a ship-like hull (long flat box, 4000 kg, with a heavy keel part) floating in water
# (global area, plane z=2) pushed by off-centre impulses (action 2 with a point) and a velocity
# change while it rocks.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
geom name=ground type=box size=50,50,0.5
entity name=ground type=static pos=32,32,-20
part ent=ground geom=ground mass=0
geom name=hull type=box size=4,1.2,0.6
geom name=keel type=box size=2,0.15,0.3
entity name=ship type=rigid pos=32,32,2.6
part ent=ship geom=hull mass=3000
part ent=ship geom=keel mass=1000 pos=0,0,-0.8
area name=water kind=global
params target=water type=12 f4=1000 f16=1000 v24=0,0,0 v40=0,0,1 v52=32,32,2 i72=0
params target=ship type=12 f4=1000 f16=1000
trace ents=ship
print
step n=60
action target=ship type=2 v4=0,6000,0 v52=34,32,2.6
step n=40
action target=ship type=2 v4=8000,0,-4000 v52=30,32.5,2.4
step n=40
action target=ship type=10 v12=1.5,0,0
step n=60
action target=ship type=2 v4=0,0,20000 v52=35,32,2.6
step n=100
