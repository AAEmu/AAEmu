# P5: particles bouncing on a static box floor (surfaces with different bounciness and
# friction; particle sizes, thicknesses, bounce/sleep speeds). Every params line starts with
# the "blank" pe_params_particle (all fields unused) and then sets its fields.
grid axisz=2 org=0,0,-100 n=64,64 step=4,4
surface idx=1 bounce=0.8 friction=0.2
surface idx=2 bounce=0.3 friction=0.9
surface idx=3 bounce=0 friction=0
geom name=ground type=box size=50,50,0.5
entity name=ground type=static pos=32,32,-0.5
part ent=ground geom=ground mass=0 i64=1
entity name=a type=particle pos=30,30,3
entity name=b type=particle pos=32,30,3
entity name=c type=particle pos=34,30,2
entity name=d type=particle pos=36,30,1
params target=a type=3 i4=U f8=U f12=U f16=U f20=U f32=U f36=U f40=U f44=U f48=U i52=U f56=U f68=U f80=U f92=U f104=U f128=U f132=U f136=U p144=unused i152=U i156=U i160=U f8=0.5 f12=0.2 v20=0.6,0,-0.8 f32=4 i52=1
params target=b type=3 i4=U f8=U f12=U f16=U f20=U f32=U f36=U f40=U f44=U f48=U i52=U f56=U f68=U f80=U f92=U f104=U f128=U f132=U f136=U p144=unused i152=U i156=U i160=U f8=1 f12=0.4 f16=0.1 v20=0,1,0 f32=2 i52=2 f132=0.5
params target=c type=3 i4=U f8=U f12=U f16=U f20=U f32=U f36=U f40=U f44=U f48=U i52=U f56=U f68=U f80=U f92=U f104=U f128=U f132=U f136=U p144=unused i152=U i156=U i160=U f8=0.1 f12=0.05 v20=0.6,0.8,0 f32=6 i52=3
params target=d type=3 i4=U f8=U f12=U f16=U f20=U f32=U f36=U f40=U f44=U f48=U i52=U f56=U f68=U f80=U f92=U f104=U f128=U f132=U f136=U p144=unused i152=U i156=U i160=U f8=2 f12=0.3 f16=0.3 v20=0,0,-1 f32=8 i52=1 f136=0.1
trace ents=a,b,c,d
print
step n=200
status target=a type=8 dump=0,30
status target=b type=8 dump=0,30
status target=c type=9
status target=c type=9
getparams target=d type=3 dump=0,36
